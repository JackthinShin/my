---
import { formatDate, getReadingTime } from '@/lib/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body || '');
---

<a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="post-card">
  <div class="post-card-meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span class="reading-time">{readingTime} min read</span>
  </div>
  <h2 class="post-card-title">{post.data.title}</h2>
  {post.data.description && (
    <p class="post-card-desc">{post.data.description}</p>
  )}
  {post.data.tags && post.data.tags.length > 0 && (
    <div class="post-card-tags">
      {post.data.tags.slice(0, 4).map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</a>

<style>
  .post-card {
    display: block;
    padding: 1.5rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: opacity 0.2s;
  }
  .post-card:last-of-type { border-bottom: none; }
  .post-card:hover { opacity: 0.8; text-decoration: none; }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .reading-time::before {
    content: '·';
    margin-right: 1rem;
  }

  .post-card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 0.4rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .post-card-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
  }
</style>
