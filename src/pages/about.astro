---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <div class="page-section">
    <div class="content-area">
      <h1 class="page-title">About</h1>

      <section class="about-intro">
        <p>
          你好，我是 <strong>Jackthin</strong>（施家鑫），就读于中国海洋大学计算机科学与技术专业，2025 级，目前大二。
          现在在中国海洋大学视觉实验室（OUC CVLab）参与科研学习。
        </p>
      </section>

      <div class="divider"></div>

      <section>
        <h2 class="section-heading">Research Interests</h2>
        <ul class="about-list">
          <li><strong>Computer Vision</strong> — Vision Transformers, Image Denoising, Representation Learning</li>
          <li><strong>Robotics</strong> — SLAM, Autonomous Navigation, Quadruped Robots (Unitree Go2)</li>
          <li><strong>AI Systems</strong> — Ascend NPU, Model Deployment, Edge Computing</li>
          <li><strong>Creative Tech</strong> — Photography, the intersection of visual art and technology</li>
        </ul>
      </section>

      <div class="divider"></div>

      <section>
        <h2 class="section-heading">Current Focus</h2>
        <ul class="about-list">
          <li>Reading foundational CV papers: ViT, DeiT, MAE, CLIP — building a systematic understanding of visual models</li>
          <li>Developing autonomous patrol systems for Unitree Go2 using MQTT, SLAM, and Nav2</li>
          <li>Building this personal website and a photography portfolio at <a href="https://photoflife.site" target="_blank">photoflife.site</a></li>
          <li>Contributing to Huawei Ascend ecosystem — CATLASS operator development on 910B platform</li>
        </ul>
      </section>

      <div class="divider"></div>

      <section>
        <h2 class="section-heading">Contact</h2>
        <div class="contact-links">
          <a href="mailto:jackthin@foxmail.com">jackthin@foxmail.com</a>
          <a href="https://github.com/jackthinshin" target="_blank" rel="noopener">GitHub</a>
          <a href="https://photoflife.site" target="_blank" rel="noopener">Photography Portfolio</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 2rem;
  }
  .about-intro p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
    max-width: 65ch;
  }
  .divider {
    height: 1px;
    background: var(--color-border);
    margin: 2.5rem 0;
  }
  .section-heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }
  .about-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .about-list li {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.7;
    padding-left: 1rem;
    border-left: 2px solid var(--color-border);
  }
  .about-list li strong { color: var(--color-ink); }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .contact-links a {
    font-size: 0.9375rem;
    color: var(--color-accent);
    text-decoration: none;
  }
  .contact-links a:hover { text-decoration: underline; }
</style>
