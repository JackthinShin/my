---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestPosts = sortedPosts.slice(0, 4);
---

<BaseLayout title="Home">
  <div class="page-section">
    <div class="content-area">
      <!-- Hero -->
      <section class="hero">
        <img src="/images/avatar.jpg" alt="Jackthin 的头像" width="512" height="512" class="hero-avatar" />
        <h1 class="hero-title">Jackthin</h1>
        <p class="hero-subtitle">
          CS student exploring computer vision, robot grasping,<br class="hide-mobile" />
          drone/ocean research, and photography at Ocean University of China.
        </p>
        <p class="hero-now">
          <span class="hero-label">Now</span>
          Exploring object recognition and grasping with the Unitree Go2 robot dog and a robotic arm, while starting research in the CV Lab on computer vision, drones, and ocean applications.
        </p>
        <div class="hero-tags">
          <span>Computer Vision</span>
          <span>Robot Grasping</span>
          <span>Quadruped Robots</span>
          <span>Drones & Ocean</span>
          <span>Photography</span>
        </div>
        <a href="/series/go2" class="hero-series-link">
          Unitree Go2 系列<span class="hero-series-arrow">→</span>
        </a>
      </section>

      <div class="divider"></div>

      <!-- Latest Posts -->
      <section>
        <div class="section-header">
          <h2 class="section-title">Latest Writing</h2>
          <a href="/blog" class="section-link">View all →</a>
        </div>
        <div class="post-list">
          {latestPosts.map(post => (
            <PostCard post={post} />
          ))}
        </div>
      </section>

      <div class="divider"></div>

      <!-- Quick Links -->
      <section class="quick-links">
        <a href="/projects" class="ql-item">
          <span class="ql-title">Projects</span>
          <span class="ql-desc">Things I've built and contributed to</span>
        </a>
        <a href="/archive" class="ql-item">
          <span class="ql-title">Archive</span>
          <span class="ql-desc">Everything I've written, in order</span>
        </a>
        <a href="/about" class="ql-item">
          <span class="ql-title">About</span>
          <span class="ql-desc">More about me and my work</span>
        </a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .hero { padding: 4rem 0 2rem; }
  .hero-avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 0 1.5rem;
    border: 3px solid var(--color-border);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }
  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }
  .hero-now {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0 0 1rem;
    padding: 1rem;
    background: var(--color-bg-alt);
    border-radius: 8px;
    border-left: 3px solid var(--color-accent);
  }
  .hero-label {
    font-weight: 600;
    color: var(--color-accent);
    margin-right: 0.25rem;
  }
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hero-tags span {
    font-size: 0.8125rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }
  .hero-series-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    border: 1px solid var(--color-accent);
    border-radius: 9999px;
    padding: 0.4rem 0.9rem;
    transition: background 0.2s, color 0.2s;
  }
  .hero-series-link:hover {
    background: var(--color-accent);
    color: #fff;
    text-decoration: none;
  }
  .hero-series-arrow { transition: transform 0.2s; }
  .hero-series-link:hover .hero-series-arrow { transform: translateX(3px); }

  .divider {
    height: 1px;
    background: var(--color-border);
    margin: 2rem 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
  }
  .section-link {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
  }
  .section-link:hover { text-decoration: underline; }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .quick-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .ql-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .ql-item:hover {
    border-color: var(--color-text-muted);
    text-decoration: none;
  }
  .ql-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .ql-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .hero-title { font-size: 2.5rem; }
    .hide-mobile { display: none; }
    .quick-links { grid-template-columns: 1fr; }
  }
</style>
