---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const SERIES_TAG = 'opi-ai-studio';
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const seriesPosts = allPosts
  .filter((p) => p.data.tags?.includes(SERIES_TAG))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<BaseLayout title="OPi AI Studio 系列">
  <div class="page-section">
    <div class="content-area">
      <span class="series-badge">Series</span>
      <h1 class="page-title">OPi AI Studio 系列</h1>
      <p class="page-desc">
        在<b>异构计算</b>设备上完整跑通大模型推理的部署记录——
        先在 <b>Windows</b> 下完成驱动 + CANN + llama.cpp 的基础配置，
        再切到 <b>Ubuntu 双系统</b>，最终在 Ubuntu 上以 <b>310P 驱动 + MindIE + Daemon</b> 排出一套可复现的流程。
      </p>
      {seriesPosts.length > 0 ? (
        <div class="post-list">
          {seriesPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="empty">系列里还没有文章。</p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .series-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    padding: 0.2rem 0.7rem;
    margin-bottom: 1rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: var(--color-ink);
  }
  .page-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 65ch;
    margin: 0 0 2rem;
  }
  .page-desc b {
    color: var(--color-ink);
    font-weight: 600;
  }
  .post-list {
    display: flex;
    flex-direction: column;
  }
  .empty {
    color: var(--color-text-muted);
  }
</style>
